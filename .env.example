# ODE reads values from the process environment. This file is an example only:
# the application does not load .env automatically. Never put real secrets,
# internal hostnames or corporate paths in a committed copy.

# Local HTTP profile. Additional names do not enable HTTPS or make a LAN
# deployment production-ready.
ODE_ALLOWED_HOSTS=

# Verified backups must stay outside the repository.
ODE_BACKUP_DIR=C:\path\outside-git\ode-backups

# Optional live DCIM collection through Microsoft Edge. These are settings,
# not API keys. Keep the Edge profile and routing JSON outside Git.
ODE_MONITORING_DCIM_BASE_URL=https://dcim.example.invalid
ODE_MONITORING_RULES_DIR=C:\path\outside-git\monitoring-rules
ODE_MONITORING_EDGE_PROFILE_DIR=C:\path\outside-git\edge-profile
ODE_MONITORING_HEADLESS=false
ODE_MONITORING_COLLECT_DCIM=true
ODE_MONITORING_DEV_MOCK=false

# Knowledge base attachments. Keep the directory outside Git and include it in backups.
ODE_KNOWLEDGE_UPLOAD_DIR=C:\path\outside-git\knowledge-uploads
ODE_KNOWLEDGE_MAX_ATTACHMENT_MB=15

# Test/review flags such as ODE_TEST_MODE, ODE_MIGRATION_PILOT and
# ODE_FULL_MIGRATION_CANDIDATE are intentionally absent. Use only the dedicated
# launchers documented in docs/RUNTIME_CONFIGURATION.md.
